equipments = Equipment.query.all()

if not equipments:
    print("Nenhum equipamento encontrado.")
else:
    for eq in equipments:
        eq.generate_qr_code()
        print(f"OK: {eq.code}")

    db.session.commit()
    print("-" * 50)
    print(f"{len(equipments)} QR Codes regenerados!")
    print("\nNovo formato: https://tourmanager.app/eq/[CODIGO]")
